# korg's runtime environment — the template for /datastore/korg/korg.env on
# kubsdb, which docker-compose.yml reads via `env_file:`.
#
# The real file is NOT in this repo and must never be: deploy/korg.env is
# gitignored. Write it with deploy/cold-start.sh.
#
# **This file holds no secret** (korg #2547, program korg:2440). It used to
# carry DATABASE_URL with the database password embedded in it, which made
# kubsdb hold a second copy of a password /etc/khomelab/secrets.env already had.
# Now:
#
#   - the password lives ONLY in the age store and, rendered from it,
#     /etc/khomelab/secrets.env as KORG_DB_PASSWORD (root:khomelab 0640);
#   - the credential-free DATABASE_URL lives in docker-compose.yml, where it is
#     reviewable in git;
#   - korg-core combines the two at startup (crates/korg-core/src/db.rs).
#
# The mode stays 0600 anyway — it costs nothing and nothing here needs sharing.
#
# KORG_WEB_DIR and KORG_LISTEN_ADDR come from the image (Dockerfile ENV);
# setting them here would just create a second place for them to drift, and
# KORG_FRAME_ANCESTORS (the embed allowlist, #1468) is in docker-compose.yml
# because it is not a secret and belongs somewhere reviewable — a gitignored
# file is the wrong home for "which origins may frame korg".

# Required. korg-core rejects a missing or invalid IANA zone at startup by
# design — no geographic default is guessed — so a first deploy onto a host
# without it crash-loops immediately.
KORG_TIMEZONE=America/Los_Angeles
