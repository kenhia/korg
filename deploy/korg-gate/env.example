# /etc/korg-gate/env — korg-gate's environment (root:root, mode 0600).
# Every variable is documented in docs/gate.md.

# Loopback only. Funnel terminates TLS and forwards here.
KORG_GATE_LISTEN=127.0.0.1:8475

# The connector URL exactly as entered in claude.ai — it is the OAuth
# `resource`, byte for byte, and must end in /mcp.
KORG_GATE_PUBLIC_URL=https://korg-gate.encke-wahoo.ts.net/mcp

# korg-api's MCP endpoint, reached over the tailnet.
KORG_GATE_UPSTREAM=https://kubsdb.encke-wahoo.ts.net:5674/mcp

# The owner passphrase (20+ characters). Lives in krot; never commit a value.
KORG_GATE_PASSPHRASE=

# systemd's StateDirectory=korg-gate.
KORG_GATE_STATE_DIR=/var/lib/korg-gate

# Header carrying the caller's address from tailscaled; the last entry is used.
KORG_GATE_CLIENT_IP_HEADER=x-forwarded-for

# Log filter (tracing EnvFilter syntax).
KORG_GATE_LOG=info
