[Unit]
Description=korg-calendar: publish Ken's tagged days and the holidays as kdash:calendar (korg WI 4664)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/tools/korg
# kdash-pub is in /usr/local/bin; ~/.local/bin is carried for the
# repo-user-timer recipe's PATH guard, which every consumer's unit keeps.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/src/tools/korg/bin/korg-calendar
TimeoutStartSec=2min
